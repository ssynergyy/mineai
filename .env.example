# Minecraft connection
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=05SynergyPvlls
MC_VERSION=

# llama.cpp OpenAI-compatible server
LLAMA_URL=http://127.0.0.1:11111/v1
LLAMA_API_KEY=no-key-required
LLAMA_MODEL=

# Local command authentication for rank/modded-server chat.
# This is checked by Node.js BEFORE the command reaches the AI.
COMMAND_PASSWORD=change-me
# Optional fallback if a password command has no recognizable username before the password.
COMMAND_DEFAULT_PLAYER=

# Agent
AGENT_MAX_STEPS=20
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=700
AGENT_OBSERVATION_RADIUS=16
