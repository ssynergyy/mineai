# Minecraft connection
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=05SynergyPvlls
MC_VERSION=1.20.4

# llama.cpp OpenAI-compatible server
LLAMA_URL=http://127.0.0.1:11111/v1
LLAMA_API_KEY=no-key-required
LLAMA_MODEL=

# Agent
AGENT_MAX_STEPS=24
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=900
AGENT_OBSERVATION_RADIUS=20

# Local command/security settings
# Non-EliteSynergy users need this password when issuing commands.
COMMAND_PASSWORD=epwd
SECURITY_ENABLED=true
SECURITY_OWNER=EliteSynergy

# Optional initial lists. These can also be changed by the owner in-game.
FRIENDLY_PLAYERS=
HOSTILE_PLAYERS=

# Survival automation
AUTO_EAT=true
AUTO_EQUIP_ARMOR=true

# IMPORTANT: protected players are NOT configured here. Manage them in-game.
